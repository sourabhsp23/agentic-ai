# Copy to backend/.env (local run) or ./.env (docker compose) and adjust.

# --- LLM: "fake" runs fully offline; "bedrock" calls Amazon Bedrock ---
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
AWS_REGION=us-east-1
# Cheap + fast default. Alternatives: us.amazon.nova-pro-v1:0, us.amazon.nova-micro-v1:0,
# us.anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Auth option A (simplest for local dev): a Bedrock API key from
#   Bedrock console -> API keys. Prefer a short-term key; never commit it.
# AWS_BEARER_TOKEN_BEDROCK=
# Auth option B: an AWS profile / access key configured with `aws configure`
# AWS_PROFILE=default

# --- Persistence (defaults to local sqlite file) ---
# DATABASE_URL=postgresql+psycopg://insightpilot:insightpilot@localhost:5432/insightpilot

# --- Dataset storage: local folder or S3 ---
STORAGE_BACKEND=local
# S3_BUCKET=my-insightpilot-datasets

# --- Optional shared-secret auth for /api (send header X-API-Key) ---
# API_KEY=change-me

LOG_LEVEL=INFO
