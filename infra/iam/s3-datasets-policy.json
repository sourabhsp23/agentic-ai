{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteDatasets",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET/datasets/*"
    },
    {
      "Sid": "ListDatasets",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_BUCKET",
      "Condition": { "StringLike": { "s3:prefix": "datasets/*" } }
    }
  ]
}
